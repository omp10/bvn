# Copy to .env — never commit the real file.
NODE_ENV=development
PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017/balvahini
MONGO_TEST_URL=mongodb://127.0.0.1:27017/balvahini_test

# Optional for one instance, REQUIRED for more than one: OTPs, rate limits and
# the Socket.IO fan-out all need to be shared between processes.
REDIS_URL=redis://127.0.0.1:6379

# Must be a long random string in production; the server refuses to boot
# outside development if this is left at the default.
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

CORS_ORIGIN=http://localhost:5174,http://localhost:5173
# Public address of the web app — QR codes and invite links are built from this.
APP_URL=http://localhost:5174

# Razorpay. Without these the API still runs; the Pay button is simply hidden.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Dev shortcut: any OTP request returns this code instead of sending an SMS.
DEV_OTP=123456
OTP_TTL_SECONDS=300
